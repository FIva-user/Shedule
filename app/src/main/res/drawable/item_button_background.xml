<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_choose_active" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/button_choose_active" />
        </shape>
    </item>


    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/button_choose_unactive" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/button_choose_unactive" />
        </shape>
    </item>
</selector>