<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <LinearLayout
        android:id="@+id/widget_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/widget_header_num"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:background="#DBDADA"
            android:paddingVertical="8dp"
            android:text="Пара"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#333333"/>
        <TextView
            android:id="@+id/widget_header_time"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:background="#E4E4E4"
            android:paddingVertical="8dp"
            android:text="Время"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#333333"/>
        <TextView
            android:id="@+id/widget_header_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#F0F0F0"
            android:paddingVertical="8dp"
            android:text="Предмет"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#333333"/>
        </LinearLayout>



    <ListView
        android:id="@+id/widget_lessons_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#DBDADA"
        android:dividerHeight="1dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#F4F3F3"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/widget_tvWidgetDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:gravity="center"
            android:textColor="#3C3C3C" />
        
        <ImageView
            android:id="@+id/widget_btn_refresh"
            android:gravity="left|center_vertical"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:src="@drawable/baseline_refresh_24"
            android:scaleType="center"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</LinearLayout>